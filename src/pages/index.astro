---
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/SectionLabel.astro';
import TriLink from '../components/TriLink.astro';
import Video from '../components/Video.astro';
import Icon from '../components/Icons.astro';
import Contact from '../components/Contact.astro';
import { hero, about, clients, awards, projects } from '../data/site.js';
---
<Base>
  <!-- Hero -->
  <section class="hero" aria-label="Introduction">
    <div class="hero__media" aria-hidden="true">
      <div class="hero__parallax" data-parallax="hero"><Video src={hero.video} /></div>
    </div>
    <div class="hero__inner grid">
      <h1 class="hero__title t-display">
        <span class="hero__line"><span class="hero__word">Andrew</span></span>
        <span class="hero__line"><span class="hero__word">Williams</span></span>
      </h1>
      <div class="hero__aside">
        <div class="hero__text t-body">
          {hero.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <a class="hero__btn" href="#about" aria-label="Scroll to About">
          <span class="hero__btn-icon hero__btn-icon--out"><Icon name="arrow-down" /></span>
          <span class="hero__btn-icon hero__btn-icon--in"><Icon name="arrow-down" /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="about">
    <div class="grid section-grid appear" data-appear>
      <SectionLabel text="About" />
      <div class="section-content">
        <div class="about__top">
          <h2 class="about__heading t-h2">{about.heading}</h2>
          <div class="about__text">
            <div class="about__paras t-body">
              {about.paragraphs.map((p) => <p>{p}</p>)}
            </div>
            <TriLink href="#contact" label="Let’s Chat" />
          </div>
        </div>
        <div class="about__videos">
          <div class="media about__big"><Video src={about.bigVideo} /></div>
          <div class="media about__small"><Video src={about.smallVideo} /></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Clients -->
  <section class="clients" aria-labelledby="clients-title">
    <div class="clients__label t-mono-16">
      <span aria-hidden="true">\</span>
      <h2 id="clients-title">Selected Clients</h2>
    </div>
    <div class="ticker appear" data-appear style="--appear-y: 96px">
      <div class="ticker__track" data-ticker>
        {[0, 1, 2].map((copy) => (
          <ul class="ticker__group" aria-hidden={copy > 0 ? 'true' : undefined}>
            {clients.map((name) => (
              <li class="ticker__item t-big">
                <span>{name}</span>
                <span class="ticker__div" aria-hidden="true">\</span>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </section>

  <!-- Awards -->
  <section class="awards">
    <div class="grid section-grid">
      <SectionLabel text="Awards" />
      <ul class="section-content awards__list">
        {awards.map((a) => (
          <li class="award t-body">
            <div class="award__name">
              <span class="appear" data-appear style="--appear-y: 42px">{a.name}</span>
              <span class="appear c-50" data-appear style="--appear-y: 42px">{a.year}</span>
            </div>
            <div class="award__meta">
              <span class="appear c-50" data-appear style="--appear-y: 42px">{a.category}</span>
              <span class="appear" data-appear style="--appear-y: 42px">{a.wins}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Works -->
  <section id="works" class="works">
    <div class="grid section-grid appear" data-appear>
      <SectionLabel text="Works" />
      <div class="section-content works__list">
        {projects.map((p) => (
          <article class="pcard">
            <div class="media pcard__media"><Video src={p.cover} /></div>
            <div class="pcard__main">
              <h3 class="pcard__name t-h4">{p.name}</h3>
              <dl class="pcard__info">
                <div>
                  <dt class="t-mono-14">Year</dt>
                  <dd class="t-mono-16 c-50">{p.year}</dd>
                </div>
                <div>
                  <dt class="t-mono-14">Category</dt>
                  <dd class="t-mono-16 c-50">{p.category}</dd>
                </div>
              </dl>
            </div>
            <div class="pcard__bottom">
              <p class="pcard__summary t-body">{p.summary}</p>
              <TriLink href={`/${p.slug}`} label="View Project" />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Contact />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    height: max(100vh, 720px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--white-08);
  }
  .hero__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .hero__parallax {
    position: absolute;
    left: 0;
    top: -20%;
    width: 100%;
    height: 120%;
    will-change: transform;
  }
  .hero__parallax :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__inner {
    position: relative;
    width: 100%;
    padding-bottom: 32px;
    align-items: stretch;
    mix-blend-mode: difference;
  }
  .hero__title {
    grid-column: 1 / span 8;
    align-self: end;
  }
  .hero__line {
    display: block;
    overflow: hidden;
  }
  .hero__word {
    display: block;
    animation: hero-rise 1s var(--ease-quart) 0.1s both;
  }
  .hero__line + .hero__line .hero__word {
    animation-delay: 0.15s;
  }
  @keyframes hero-rise {
    from { transform: translateY(280px); }
    to { transform: none; }
  }
  .hero__aside {
    grid-column: 10 / span 3;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    padding: 8px 0;
    animation: hero-fade 1s var(--ease-quart) 0.7s both;
  }
  @keyframes hero-fade {
    from { opacity: 0; transform: translateY(64px); }
    to { opacity: 1; transform: none; }
  }
  .hero__text {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .hero__text p {
    max-width: 240px;
  }
  .hero__btn {
    position: relative;
    display: block;
    width: 36px;
    height: 48px;
    border: 0.5px solid var(--white);
    border-radius: 1000px;
    overflow: hidden;
    color: var(--white);
    transition: background-color var(--hover);
  }
  .hero__btn-icon {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 16px;
    height: 16px;
    margin: -8px 0 0 -8px;
    transition: transform var(--hover), opacity var(--hover);
  }
  .hero__btn-icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .hero__btn-icon--in {
    color: var(--black);
    opacity: 0;
    transform: translateY(-36px);
  }
  .hero__btn:hover {
    background-color: var(--white);
  }
  .hero__btn:hover .hero__btn-icon--out {
    opacity: 0;
    transform: translateY(36px);
  }
  .hero__btn:hover .hero__btn-icon--in {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 1439.98px) {
    .hero__aside { grid-column: 9 / span 4; }
    .hero__text p { max-width: 320px; }
  }
  @media (max-width: 1279.98px) {
    .hero__title { grid-column: 1 / -1; }
    .hero__aside {
      grid-column: 1 / -1;
      justify-content: flex-start;
      gap: 80px;
      margin-top: 23px;
      padding-bottom: 0;
    }
  }
  @media (max-width: 719.98px) {
    .hero__title { text-align: center; }
    .hero__aside {
      align-items: center;
      gap: 56px;
      margin-top: 24px;
      text-align: center;
    }
    .hero__text p { max-width: none; }
    .hero__text p + p { display: none; }
  }

  /* ---------- About ---------- */
  .about {
    padding: 240px 0 120px;
  }
  .about__top,
  .about__videos {
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    column-gap: var(--gap);
    align-items: start;
  }
  .about__heading {
    grid-column: 1 / span 6;
    max-width: 568px;
  }
  .about__text {
    grid-column: 7 / span 4;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 48px;
    padding: 8px 0;
  }
  .about__paras {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .about__paras p {
    max-width: 424px;
  }
  .about__videos {
    margin-top: 88px;
  }
  .about__big {
    grid-column: 1 / span 6;
    height: 900px;
  }
  .about__small {
    grid-column: 7 / span 4;
    height: 640px;
  }
  @media (max-width: 1439.98px) {
    .about__heading { max-width: 480px; }
    .about__paras p { max-width: none; }
  }
  @media (max-width: 1279.98px) {
    .about__top { display: flex; flex-direction: column; gap: 32px; }
    .about__heading { max-width: 640px; }
    .about__text { padding: 0; }
    .about__paras p { max-width: 640px; }
    .about__big { grid-column: 1 / span 5; height: 680px; }
    .about__small { grid-column: 6 / span 5; height: 480px; }
  }
  @media (max-width: 719.98px) {
    .about { padding: 160px 0 80px; }
    .about__videos {
      grid-template-columns: 1fr;
      row-gap: var(--gap);
      margin-top: 64px;
    }
    .about__big,
    .about__small { grid-column: 1 / -1; }
    .about__big { height: 600px; }
    .about__small { height: 400px; }
  }

  /* ---------- Clients ---------- */
  .clients {
    padding: 120px 0;
  }
  .clients__label {
    display: flex;
    justify-content: center;
    gap: 8px;
    color: var(--white-50);
  }
  .ticker {
    display: flex;
    align-items: center;
    height: 97px;
    margin-top: 72px;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 22%, #000 78%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 22%, #000 78%, transparent 100%);
  }
  .ticker__track {
    display: flex;
    flex: none;
    width: max-content;
    animation: ticker var(--ticker-duration, 30s) linear infinite;
  }
  @keyframes ticker {
    from { transform: translateX(calc(var(--ticker-shift, 0px) * -1)); }
    to { transform: translateX(calc((var(--ticker-shift, 0px) + var(--ticker-distance, 33.333%)) * -1)); }
  }
  .ticker__group,
  .ticker__item {
    display: flex;
    gap: 64px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ticker__group {
    padding-right: 64px;
  }
  .ticker__item {
    white-space: nowrap;
  }
  .ticker__div {
    color: var(--white-20);
  }
  @media (max-width: 1279.98px) {
    .ticker { height: 72px; }
  }
  @media (max-width: 719.98px) {
    .clients { padding: 80px 0; }
    .ticker { margin-top: 56px; }
    .ticker__group,
    .ticker__item { gap: 24px; }
    .ticker__group { padding-right: 24px; }
  }

  /* ---------- Awards ---------- */
  .awards {
    padding: 120px 0;
  }
  .awards__list {
    list-style: none;
    margin-bottom: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .awards__list:not(:where(.x)) {
    margin-top: 0;
  }
  @media (max-width: 1279.98px) {
    .awards__list:not(:where(.x)) { margin-top: 48px; }
  }
  .award {
    position: relative;
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    column-gap: var(--gap);
    padding-bottom: 24px;
  }
  .award::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: var(--white-20);
  }
  .award__name {
    grid-column: 1 / span 6;
    display: flex;
    gap: 16px;
  }
  .award__meta {
    grid-column: 7 / span 4;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  @media (max-width: 1279.98px) {
    .award__name { grid-column: 1 / span 5; }
    .award__meta { grid-column: 6 / span 5; }
  }
  @media (max-width: 719.98px) {
    .awards { padding: 80px 0; }
    .award {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .award__name,
    .award__meta { justify-content: space-between; }
  }

  /* ---------- Works ---------- */
  .works {
    padding: 120px 0;
  }
  .works__list {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }
  .pcard {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 900px;
    padding: 48px;
  }
  .pcard__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .pcard__main {
    display: grid;
    grid-template-columns: 1.515fr 1fr;
    column-gap: var(--gap);
    align-items: start;
  }
  .pcard__info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--gap);
    margin: 0;
    padding: 0 12px;
  }
  .pcard__info dd {
    margin: 6px 0 0;
  }
  .pcard__bottom {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
    max-width: 448px;
  }
  .pcard__summary {
    max-width: 424px;
  }
  @media (max-width: 1279.98px) {
    .pcard {
      height: 880px;
      padding: 48px 32px;
    }
    .pcard__main { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 719.98px) {
    .works { padding: 80px 0; }
    .pcard {
      height: 600px;
      padding: 40px 24px;
    }
    .pcard__main {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }
    .pcard__info {
      width: 100%;
      padding: 0;
    }
  }
</style>
