---
import SectionLabel from './SectionLabel.astro';
import Roll from './Roll.astro';
import Icon from './Icons.astro';
import Video from './Video.astro';
import { site, contact } from '../data/site.js';

interface Props {
  /** Project pages sit the section further from the media above it. */
  spacious?: boolean;
}
const { spacious = false } = Astro.props;

const links = [
  { label: site.email, href: `mailto:${site.email}`, wide: true },
  ...site.socials.map((s) => ({ ...s, wide: false })),
];
---
<section id="contact" class:list={['contact', { 'contact--spacious': spacious }]}>
  <div class="grid section-grid appear" data-appear>
    <SectionLabel text="Contact" />
    <div class="section-content">
      <h2 class="t-h2 contact__heading">Get In<br />Touch</h2>

      <div class="contact__links">
        {links.map((link) => (
          <a
            class:list={['crow', 'roll-host', { 'crow--wide': link.wide }]}
            href={link.href}
            target="_blank"
            rel="noopener"
          >
            <span class="crow__text t-big"><Roll text={link.label} /></span>
            <span class="crow__icon" aria-hidden="true">
              <Icon name="arrow-up-right" class="crow__arrow crow__arrow--a" />
              <Icon name="arrow-up-right" class="crow__arrow crow__arrow--b" />
            </span>
          </a>
        ))}
      </div>

      <div class="contact__split">
        <div class="media contact__video"><Video src={contact.video} /></div>
        <div class="cblock">
          <div class="cblock__head">
            <h3 class="t-h3 cblock__title">{contact.formHeading}</h3>
          </div>
          <form class="cform" method="post" data-contact-form data-email={site.email}>
            <label class="sr-only" for="cf-name">Name</label>
            <input id="cf-name" class="cform__field" type="text" name="name" placeholder="NAME" autocomplete="name" />
            <label class="sr-only" for="cf-email">Email</label>
            <input id="cf-email" class="cform__field" type="email" name="email" placeholder="EMAIL" autocomplete="email" />
            <label class="sr-only" for="cf-message">Message</label>
            <textarea id="cf-message" class="cform__field cform__message" name="message" placeholder="HOW CAN I HELP YOU?"></textarea>
            <input class="cform__submit" type="submit" value="SEND A MESSAGE" data-default="SEND A MESSAGE" />
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 120px 0 240px;
  }
  .contact--spacious {
    padding-top: 240px;
  }
  @media (max-width: 719.98px) {
    .contact {
      padding: 80px 0 160px;
    }
    .contact--spacious {
      padding-top: 160px;
    }
  }

  .contact__heading {
    max-width: 568px;
  }
  @media (max-width: 1439.98px) {
    .contact__heading { max-width: 640px; }
  }

  /* Contact rows */
  .contact__links {
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    gap: 32px var(--gap);
    margin-top: 88px;
  }
  .crow {
    position: relative;
    grid-column: span 10;
    display: flex;
    align-items: center;
    gap: 0;
    padding-bottom: 12px;
    color: var(--white);
    --roll-gap: 8px;
  }
  .crow::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 4px;
    background: var(--white-20);
    pointer-events: none;
  }
  @media (min-width: 1440px) {
    .crow:not(.crow--wide):nth-child(2) { grid-column: span 4; }
    .crow:not(.crow--wide):nth-child(3) { grid-column: span 6; }
  }
  .crow__text {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    overflow: hidden;
  }
  .crow__text :global(.roll) {
    width: 100%;
  }
  .crow:hover .crow__text :global(.roll > span) {
    color: var(--white-50);
  }
  .crow__icon {
    position: relative;
    flex: none;
    width: 48px;
    height: 48px;
    margin-right: 16px;
    overflow: hidden;
    color: var(--white);
    transition: opacity var(--hover);
  }
  .crow__icon :global(.crow__arrow) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: transform var(--hover);
  }
  .crow__icon :global(.crow__arrow--b) {
    transform: translate(-100%, 100%);
  }
  .crow:hover .crow__icon {
    opacity: 0.5;
  }
  .crow:hover .crow__icon :global(.crow__arrow--a) {
    transform: translate(100%, -100%);
  }
  .crow:hover .crow__icon :global(.crow__arrow--b) {
    transform: none;
  }

  /* Video + form */
  .contact__split {
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    column-gap: var(--gap);
    align-items: start;
    margin-top: 88px;
  }
  .contact__video {
    grid-column: span 4;
    height: 640px;
  }
  .cblock {
    grid-column: 5 / span 6;
    display: flex;
    flex-direction: column;
    gap: 16px;
    height: 900px;
    background: var(--block);
  }
  .cblock__head {
    position: relative;
    padding: 48px;
    border-bottom: 1px solid var(--white-08);
  }
  .cblock__title {
    max-width: 400px;
  }
  .cform {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    margin: 0;
  }
  .cform__field {
    display: block;
    width: 100%;
    margin: 0;
    padding: 28px 48px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--white);
    caret-color: var(--white);
    font-family: 'Inter Medium', var(--sans);
    font-weight: 500;
    font-size: 24px;
    line-height: 1.4;
    outline: none;
    -webkit-appearance: none;
    appearance: none;
  }
  .cform__field::placeholder {
    color: var(--white-40);
    opacity: 1;
  }
  .cform__message {
    flex: 1 1 auto;
    min-height: 120px;
    resize: vertical;
  }
  .cform__submit {
    display: block;
    width: 100%;
    margin: 0;
    padding: 28px 48px;
    border: 0;
    border-radius: 0;
    background: var(--white);
    color: var(--black);
    font-family: 'Inter Medium', var(--sans);
    font-weight: 600;
    font-size: 24px;
    line-height: 1.4;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    transition: opacity 0.3s var(--ease);
  }
  .cform__submit:hover {
    opacity: 0.8;
  }

  @media (max-width: 1279.98px) {
    .contact__split {
      grid-template-columns: 1fr;
      row-gap: var(--gap);
    }
    .contact__video,
    .cblock {
      grid-column: 1 / -1;
      height: 880px;
    }
  }
  @media (max-width: 719.98px) {
    .contact__links {
      gap: 24px;
      margin-top: 64px;
    }
    /* Social links form their own group with a wider inner gap. */
    .crow:nth-child(3) {
      margin-top: 8px;
    }
    .crow__icon {
      width: 24px;
      height: 24px;
      margin-right: 0;
    }
    .contact__split {
      margin-top: 64px;
    }
    .contact__video { height: 600px; }
    .cblock { height: 720px; }
    .cblock__head { padding: 40px 24px; }
    .cform__field,
    .cform__submit { padding: 24px; }
  }
</style>
